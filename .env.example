# Use a MongoDB replica set/Atlas deployment that supports transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/centuri?replicaSet=rs0
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# First installation only: a private random setup code of at least 32 characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep private; the first Chief enters it only when sign-up asks for setup.
# CLAN_BOOTSTRAP_TOKEN=
# Optional canonical public origin when a proxy changes request.url.
# APP_ORIGIN=https://centuri.example.com
# Enable only when your trusted proxy replaces x-forwarded-for.
# TRUST_PROXY=true
# Sessions use random opaque tokens stored as SHA-256 hashes in MongoDB.
# Legacy JWT_SECRET is no longer used. Existing JWT sessions must sign in again.
